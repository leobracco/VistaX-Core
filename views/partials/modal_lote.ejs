<div id="modal-lote" class="vx-modal-overlay" style="display:none" onclick="if(event.target===this)cerrarModalLote()">
  <div class="vx-modal-box">
<div class="vx-modal-header">
      <span id="modal-lote-titulo"><i class="fas fa-seedling"></i> INICIAR LOTE</span>
      <button class="vx-modal-close" onclick="cerrarModalLote()">✕</button>
    </div>
<div id="panel-nuevo-lote">
      <div class="vx-form-grid">

        <div class="vx-field">
          <label>Nombre del Lote <span class="req">*</span></label>
          <input id="lote-inp-nombre" type="text" placeholder="Ej: La Paloma Norte"
                 autocomplete="off" spellcheck="false"
                 oninput="this.style.borderColor=''" />
        </div>

        <div class="vx-field">
          <label>Cultivo <span class="req">*</span></label>
          <select id="lote-inp-cultivo">
            <option value="">— Seleccionar —</option>
            <option value="maiz">Maíz</option>
            <option value="soja">Soja</option>
            <option value="girasol">Girasol</option>
            <option value="sorgo">Sorgo</option>
            <option value="trigo">Trigo</option>
            <option value="cebada">Cebada</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div class="vx-field">
          <label>Variedad</label>
          <input id="lote-inp-variedad" type="text" placeholder="Ej: DK7210 VT3P"
                 autocomplete="off" spellcheck="false" />
        </div>

        <div class="vx-field">
          <label>Establecimiento</label>
          <input id="lote-inp-estab" type="text" placeholder="Ej: Los Aromos"
                 autocomplete="off" spellcheck="false" />
        </div>

      </div>

      <div class="vx-modal-actions">
        <button class="vx-btn vx-btn-ghost" onclick="cerrarModalLote()">Cancelar</button>
        <button class="vx-btn vx-btn-primary" onclick="iniciarLoteDesdeMonitor()">
          <i class="fas fa-play"></i> Iniciar Lote
        </button>
      </div>
    </div>
<div id="panel-lote-activo" style="display:none">
      <div class="vx-lote-activo-info">
        <div class="vx-lote-row">
          <span class="vx-lote-label">Lote</span>
          <span class="vx-lote-value" id="lote-act-nombre">—</span>
        </div>
        <div class="vx-lote-row">
          <span class="vx-lote-label">Cultivo</span>
          <span class="vx-lote-value" id="lote-act-cultivo">—</span>
        </div>
        <div class="vx-lote-row">
          <span class="vx-lote-label">Variedad</span>
          <span class="vx-lote-value" id="lote-act-variedad">—</span>
        </div>
        <div class="vx-lote-row">
          <span class="vx-lote-label">Establecimiento</span>
          <span class="vx-lote-value" id="lote-act-estab">—</span>
        </div>
        <div class="vx-lote-row">
          <span class="vx-lote-label">Inicio</span>
          <span class="vx-lote-value" id="lote-act-inicio">—</span>
        </div>
        <div class="vx-lote-row">
          <span class="vx-lote-label">Puntos GPS</span>
          <span class="vx-lote-value" id="lote-act-puntos">—</span>
        </div>
      </div>

      <div class="vx-modal-actions">
        <button class="vx-btn vx-btn-ghost" onclick="cerrarModalLote()">Volver</button>
        <button class="vx-btn vx-btn-danger" onclick="cerrarLoteDesdeMonitor()">
          <i class="fas fa-stop"></i> Cerrar Lote
        </button>
      </div>
    </div>

  </div>
</div>
