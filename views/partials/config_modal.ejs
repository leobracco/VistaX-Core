<div id="modal-config" class="modal-overlay">
  <div class="modal-content config-fullscreen">
    <div class="modal-header">
      <div class="header-title">
        <i class="fas fa-tools"></i>
        <div>
          <h2>CONFIGURACIÓN DEL IMPLEMENTO</h2>
          <small id="cfg-id-maquina">ID: tanzi_43_semilla</small>
        </div>
      </div>
      <button class="close-btn" onclick="cerrarModal()">&times;</button>
    </div>

    <div class="modal-body">
      <div class="config-layout">
        <aside class="config-sidebar">
          <div class="sidebar-nav">
            <button class="tab-btn active" onclick="switchTab('general')">
              <i class="fas fa-sliders-h"></i> <span>General</span>
            </button>
            <button class="tab-btn" onclick="switchTab('nodos')">
              <i class="fas fa-network-wired"></i> <span>Nodos</span>
            </button>
            <button class="tab-btn" onclick="switchTab('trenes')">
              <i class="fas fa-th-list"></i> <span>Trenes</span>
            </button>
            <button class="tab-btn" onclick="switchTab('sensores')">
              <i class="fas fa-microchip"></i> <span>Sensores</span>
            </button>
            <button class="tab-btn" onclick="switchTab('perfiles')">
              <i class="fas fa-user-circle"></i> <span>Perfiles</span>
            </button>
            <button class="tab-btn" onclick="switchTab('mapeo')">
              <i class="fas fa-project-diagram"></i> <span>Mapeo Visual</span>
            </button>
            <button class="tab-btn" onclick="switchTab('pantalla')">
              <i class="fas fa-desktop"></i> <span>Pantalla y Sonido</span>
            </button>
            <button class="tab-btn" onclick="switchTab('monitoreo')">
              <i class="fas fa-chart-line"></i> <span>Monitoreo</span>
            </button>
          </div>

          <div class="sidebar-info">
            <label>Máquina Actual</label>
            <select id="select-maquina-archivo" class="config-select-main">
              <option value="tanzi_43_semilla.json">
                tanzi_43_semilla.json
              </option>
            </select>
          </div>
        </aside>

        <section class="config-main">

          <!-- ===== TAB: GENERAL ===== -->
          <div id="tab-general" class="tab-content active">
            <div class="section-header">
              <h3>Estructura de la Sembradora</h3>
              <p>Parámetros base del Implemento.</p>
            </div>

            <div class="card-grid">
              <div class="input-card">
                <label>Nombre del Implemento</label>
                <input type="text" id="cfg-nombre" placeholder="Ej: Tanzi 43" />
              </div>
              <div class="input-card">
                <label>Distancia entre Líneas (m)</label>
                <input
                  type="number"
                  step="0.001"
                  id="cfg-distancia"
                  placeholder="0.525"
                />
              </div>
              <div class="input-card">
                <label>Tolerancia de Desvío (%)</label>
                <input type="number" id="cfg-tolerancia" placeholder="20" />
              </div>
              <div class="input-card">
                <label>RPM Turbina (Mínimo)</label>
                <input type="number" id="cfg-rpm-min" placeholder="2000" />
              </div>
              <div class="input-card">
                <label>RPM Turbina (Máximo)</label>
                <input type="number" id="cfg-rpm-max" placeholder="5000" />
              </div>
              <div class="input-card">
                <label>Factor K (Pulsos/Semilla)</label>
                <input
                  type="number"
                  step="0.01"
                  id="cfg-k"
                  placeholder="0.15"
                />
              </div>
              <div class="input-card">
                <label>Peso de 1000 semillas (g)</label>
                <input
                  type="number"
                  step="0.1"
                  id="cfg-p1000"
                  placeholder="Ej: 180"
                />
              </div>
            </div>

            <!-- Objetivo de Densidad por Tren -->
            <div class="section-header" style="margin-top: 20px">
              <h3>Objetivo de Densidad por Tren</h3>
              <p>Si no se especifica, se usa el objetivo global del header.</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Objetivo Tren 1 (S/M)</label>
                <input type="number" id="cfg-densidad-t1" placeholder="16" />
              </div>
              <div class="input-card">
                <label>Objetivo Tren 2 (S/M)</label>
                <input type="number" id="cfg-densidad-t2" placeholder="16" />
              </div>
            </div>

            <!-- Estructura de Trenes -->
            <div class="section-header" style="margin-top: 20px">
              <h3>Estructura de Trenes de Siembra</h3>
              <p>Define la cantidad de trenes (unidades de siembra independientes).</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Cantidad de Trenes</label>
                <input
                  type="number"
                  id="cfg-qty-trenes"
                  value="2"
                  min="1"
                  max="10"
                  placeholder="Ej: 2"
                />
              </div>
            </div>

            <!-- Cantidades por Tipo de Sensor de Siembra -->
            <div class="section-header" style="margin-top: 20px">
              <h3>Cantidad de Surcos y Sensores de Siembra</h3>
              <p>
                Define la cantidad de surcos y los sensores de siembra y fertilizante asociados.
                Cada sensor se puede asignar independientemente a cualquier surco en la pestaña <strong>Sensores</strong>.
              </p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Cantidad Total de Surcos</label>
                <input
                  type="number"
                  id="cfg-qty-surcos"
                  value="0"
                  min="0"
                  placeholder="Ej: 43"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Semilla</label>
                <input
                  type="number"
                  id="cfg-qty-semilla"
                  value="0"
                  min="0"
                  placeholder="Ej: 43"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Fertilizante en Línea</label>
                <input
                  type="number"
                  id="cfg-qty-ferti-linea"
                  value="0"
                  min="0"
                  placeholder="Ej: 43"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Fertilizante Lateral (Costado)</label>
                <input
                  type="number"
                  id="cfg-qty-ferti-costado"
                  value="0"
                  min="0"
                  placeholder="Ej: 0"
                />
              </div>
            </div>

            <!-- Sensores Especiales -->
            <div class="section-header" style="margin-top: 20px">
              <h3>Sensores de Estado y Control</h3>
              <p>Sensores de turbina, rotación, tolvas, baterías y otros dispositivos de monitoreo.</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Sensores RPM Turbina</label>
                <input
                  type="number"
                  id="cfg-qty-rpm"
                  value="0"
                  min="0"
                  placeholder="Ej: 2"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Rotación de Eje</label>
                <input
                  type="number"
                  id="cfg-qty-rotacion"
                  value="0"
                  min="0"
                  placeholder="Ej: 2"
                />
              </div>
              <div class="input-card">
                <label>Cantidad de Tolvas</label>
                <input
                  type="number"
                  id="cfg-qty-tolvas"
                  value="0"
                  min="0"
                  placeholder="Ej: 2"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Batería</label>
                <input
                  type="number"
                  id="cfg-qty-baterias"
                  value="0"
                  min="0"
                  placeholder="Ej: 2"
                />
              </div>
              <div class="input-card">
                <label>Sensores de Trabajo / Herramienta</label>
                <input
                  type="number"
                  id="cfg-qty-trabajo"
                  value="0"
                  min="0"
                  placeholder="Ej: 1"
                />
              </div>
            </div>
          </div>

          <!-- ===== TAB: NODOS ===== -->
          <div id="tab-nodos" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Inventario de Nodos ESP32</h3>
              <p>Nodos conectados al sistema. Selecciona uno para configurar sus sensores.</p>
            </div>

            <div
              style="
                display: flex;
                gap: 15px;
                margin-bottom: 20px;
                flex-wrap: wrap;
                align-items: center;
              "
            >
              <div style="flex: 1; min-width: 250px">
                <label
                  style="
                    color: var(--accent);
                    font-size: 10px;
                    font-weight: bold;
                    text-transform: uppercase;
                    display: block;
                    margin-bottom: 5px;
                  "
                >
                  Seleccionar Nodo:
                </label>
                <div style="display: flex; gap: 10px">
                  <select
                    id="select-nodo-filter"
                    class="config-select-main"
                    onchange="cambiarNodo()"
                  ></select>
                  <button
                    class="btn-cancel"
                    style="padding: 8px 15px"
                    onclick="agregarNuevoNodo()"
                  >
                    + NODO
                  </button>
                </div>
              </div>
              <button class="btn-action-add" onclick="agregarFilaSensor()">
                <i class="fas fa-plus"></i> AGREGAR CABLE
              </button>
            </div>

            <div class="mapeo-container table-scroll">
              <table class="config-table">
                <thead>
                  <tr>
                    <th>CABLE PIN (1-7)</th>
                    <th>BAJADA / SURCO #</th>
                    <th>TREN</th>
                    <th>TIPO DE SENSOR</th>
                    <th style="text-align: center">ACCIÓN</th>
                  </tr>
                </thead>
                <tbody id="lista-sensores-tbody"></tbody>
              </table>
            </div>
          </div>

          <!-- ===== TAB: TRENES ===== -->
          <div id="tab-trenes" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Estructura de Trenes de Siembra</h3>
              <p>Define la configuración física de cada tren (número de surcos, orden, nombres).</p>
            </div>

            <div class="card-grid">
              <div class="input-card">
                <label>Tren 1 - Nombre</label>
                <input type="text" id="cfg-tren1-nombre" placeholder="Ej: Delantero" />
              </div>
              <div class="input-card">
                <label>Tren 1 - Cantidad de Surcos</label>
                <input type="number" id="cfg-tren1-surcos" placeholder="19" />
              </div>
              <div class="input-card">
                <label>Tren 1 - Orden de Numeración</label>
                <input type="number" id="cfg-tren1-orden" placeholder="1" />
              </div>
            </div>

            <div class="card-grid">
              <div class="input-card">
                <label>Tren 2 - Nombre</label>
                <input type="text" id="cfg-tren2-nombre" placeholder="Ej: Trasero" />
              </div>
              <div class="input-card">
                <label>Tren 2 - Cantidad de Surcos</label>
                <input type="number" id="cfg-tren2-surcos" placeholder="24" />
              </div>
              <div class="input-card">
                <label>Tren 2 - Orden de Numeración</label>
                <input type="number" id="cfg-tren2-orden" placeholder="2" />
              </div>
            </div>

            <div class="section-header" style="margin-top: 20px">
              <h3>Vista Previa de Trenes</h3>
              <p>Estos serán los rangos de surcos asignados:</p>
            </div>
            <div id="preview-trenes" class="card-grid">
              <div style="padding: 15px; background: var(--bg-darker); border-radius: 8px; color: var(--text-muted);">
                <p>Configurar trenes arriba para ver preview</p>
              </div>
            </div>
          </div>

          <!-- ===== TAB: SENSORES ===== -->
          <div id="tab-sensores" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Mapeo de Sensores por Nodo</h3>
              <p>Asigna los cables de cada nodo a surcos y tipos de sensores.</p>
            </div>

            <div
              class="table-header-actions"
              style="flex-wrap: wrap; gap: 15px"
            >
              <div style="flex: 1; min-width: 250px">
                <label
                  style="
                    color: var(--accent);
                    font-size: 10px;
                    font-weight: bold;
                    text-transform: uppercase;
                    display: block;
                    margin-bottom: 5px;
                  "
                >
                  Viendo configuración del Nodo:
                </label>
                <div style="display: flex; gap: 10px">
                  <select
                    id="select-nodo-filter-sensores"
                    class="config-select-main"
                    onchange="cambiarNodo()"
                  ></select>
                  <button
                    class="btn-cancel"
                    style="padding: 8px 15px"
                    onclick="agregarNuevoNodo()"
                  >
                    + NODO
                  </button>
                </div>
              </div>
              <button class="btn-action-add" onclick="agregarFilaSensor()">
                <i class="fas fa-plus"></i> AGREGAR CABLE
              </button>
            </div>

            <div class="mapeo-container table-scroll">
              <table class="config-table">
                <thead>
                  <tr>
                    <th>CABLE PIN (1-7)</th>
                    <th>BAJADA / SURCO #</th>
                    <th>TREN</th>
                    <th>TIPO DE SENSOR</th>
                    <th style="text-align: center">ACCIÓN</th>
                  </tr>
                </thead>
                <tbody id="lista-sensores-tbody"></tbody>
              </table>
            </div>
          </div>

          <!-- ===== TAB: PERFILES ===== -->
          <div id="tab-perfiles" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Gestión de Perfiles de Usuario</h3>
              <p>Define roles y permisos de acceso a diferentes funcionalidades.</p>
            </div>

            <div class="card-grid">
              <div class="input-card">
                <label>Perfil Actual</label>
                <select id="cfg-perfil-actual" class="config-select-main">
                  <option value="operario">Operario</option>
                  <option value="tecnico">Técnico</option>
                  <option value="admin">Administrador</option>
                </select>
              </div>
              <div class="input-card">
                <label>Contraseña de Acceso Técnico</label>
                <input type="password" id="cfg-password-tecnico" placeholder="••••••••" />
              </div>
            </div>

            <div class="section-header" style="margin-top: 20px">
              <h3>Permisos por Rol</h3>
              <p>Define qué funcionalidades ve cada usuario según su rol.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
              <div style="border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                <h4>👤 Operario</h4>
                <label style="display: flex; gap: 8px; margin-bottom: 8px;">
                  <input type="checkbox" id="perm-op-monitoreo" checked disabled />
                  <span>Ver Monitoreo en Tiempo Real</span>
                </label>
                <label style="display: flex; gap: 8px;">
                  <input type="checkbox" id="perm-op-alertas" checked disabled />
                  <span>Ver/Silenciar Alertas</span>
                </label>
              </div>

              <div style="border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                <h4>🔧 Técnico</h4>
                <label style="display: flex; gap: 8px; margin-bottom: 8px;">
                  <input type="checkbox" id="perm-tec-config" checked />
                  <span>Editar Configuración</span>
                </label>
                <label style="display: flex; gap: 8px; margin-bottom: 8px;">
                  <input type="checkbox" id="perm-tec-calibrar" checked />
                  <span>Calibrar Sensores</span>
                </label>
                <label style="display: flex; gap: 8px;">
                  <input type="checkbox" id="perm-tec-backup" checked />
                  <span>Hacer Backup</span>
                </label>
              </div>

              <div style="border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                <h4>⚙️ Administrador</h4>
                <label style="display: flex; gap: 8px; margin-bottom: 8px;">
                  <input type="checkbox" id="perm-admin-todo" checked disabled />
                  <span>Acceso Total</span>
                </label>
                <label style="display: flex; gap: 8px;">
                  <input type="checkbox" id="perm-admin-usuarios" checked />
                  <span>Gestionar Usuarios</span>
                </label>
              </div>
            </div>
          </div>

          <!-- ===== TAB: MAPEO VISUAL ===== -->
          <div id="tab-mapeo" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Distribución en Planta</h3>
              <p>
                Verificación visual de la numeración de los surcos y trenes.
              </p>
            </div>
            <div id="mapeo-visual-canvas" class="mapeo-visual-canvas"></div>
          </div>

          <!-- ===== TAB: PANTALLA Y SONIDO ===== -->
          <div id="tab-pantalla" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Preferencias de Interfaz</h3>
              <p>Ajusta lo que quieres ver y escuchar en pantalla.</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Sonido de Alerta</label>
                <select
                  id="cfg-audio-file"
                  class="config-select-main"
                  onchange="probarSonido(this.value)"
                >
                  <option value="/sounds/alarma1.mp3">Beep Corto</option>
                  <option value="/sounds/sirena.mp3">Sirena Continua</option>
                  <option value="/sounds/buzzer.mp3">Buzzer Grave</option>
                </select>
              </div>
              <div class="input-card">
                <label>Panel Superior (Velocidad, Dosis)</label>
                <select
                  class="config-select-main"
                  onchange="
                    document.querySelector('.vistax-header').style.display =
                      this.value
                  "
                >
                  <option value="flex">Visible</option>
                  <option value="none">Oculto</option>
                </select>
              </div>
              <div class="input-card">
                <label>Panel Especiales (Turbinas, Ejes)</label>
                <select
                  class="config-select-main"
                  onchange="
                    document.getElementById('tren-especiales').style.display =
                      this.value
                  "
                >
                  <option value="flex">Visible</option>
                  <option value="none">Oculto</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ===== TAB: MONITOREO ===== -->
          <div id="tab-monitoreo" class="tab-content" style="display: none">
            <div class="section-header">
              <h3>Parámetros de Monitoreo</h3>
              <p>Configura los parámetros de alertas y monitoreo en tiempo real.</p>
            </div>

            <div class="card-grid">
              <div class="input-card">
                <label>Tiempo de Alerta (segundos)</label>
                <input type="number" id="cfg-alarma-tiempo" placeholder="2" />
              </div>
              <div class="input-card">
                <label>Velocidad Mínima para Alertar (km/h)</label>
                <input type="number" id="cfg-vel-minima-alerta" placeholder="1.5" step="0.1" />
              </div>
              <div class="input-card">
                <label>Mostrar Gráficos de Densidad</label>
                <select class="config-select-main">
                  <option value="si">Sí</option>
                  <option value="no">No</option>
                </select>
              </div>
              <div class="input-card">
                <label>Registrar Datos (Lote Activo)</label>
                <select class="config-select-main">
                  <option value="si" selected>Sí</option>
                  <option value="no">No</option>
                </select>
              </div>
            </div>
          </div>

        </section>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-footer btn-cancel" onclick="cerrarModal()">
        <i class="fas fa-times"></i> DESCARTAR
      </button>
      <button
        class="btn-footer btn-save"
        onclick="guardarConfiguracionCompleta()"
      >
        <i class="fas fa-save"></i> GUARDAR Y APLICAR
      </button>
    </div>
  </div>
</div>
