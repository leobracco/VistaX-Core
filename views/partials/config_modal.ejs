<div id="modal-config" class="modal-overlay">
  <div class="modal-content config-fullscreen">
    <div class="modal-header">
      <div class="header-title">
        <i class="fas fa-tools"></i>
        <div>
          <h2>CONFIGURACIÓN DEL IMPLEMENTO</h2>
          <small id="cfg-id-maquina">ID: —</small>
        </div>
      </div>
      <button class="close-btn" onclick="cerrarModal()">&times;</button>
    </div>

    <div class="modal-body">
      <div class="config-layout">
        <aside class="config-sidebar">
          <div class="sidebar-nav">
            <button class="tab-btn active" onclick="switchTab('perfiles')">
              <i class="fas fa-folder-open"></i> <span>Perfiles</span>
            </button>
            <button class="tab-btn" onclick="switchTab('nodos')">
  <i class="fas fa-microchip"></i> <span>Nodos</span>
</button>
            <button class="tab-btn" onclick="switchTab('general')">
              <i class="fas fa-sliders-h"></i> <span>General</span>
            </button>
            <button class="tab-btn" onclick="switchTab('sensores')">
              <i class="fas fa-microchip"></i> <span>Sensores</span>
            </button>
            <button class="tab-btn" onclick="switchTab('mapeo')">
              <i class="fas fa-project-diagram"></i> <span>Mapeo Visual</span>
            </button>
            <button class="tab-btn" onclick="switchTab('pantalla')">
              <i class="fas fa-desktop"></i> <span>Pantalla y Sonido</span>
            </button>
            <button class="tab-btn" onclick="switchTab('monitoreo')">
              <i class="fas fa-play-circle"></i> <span>Monitoreo</span>
            </button>
          </div>

          <div class="sidebar-info">
            <label>Máquina Actual</label>
            <select id="select-maquina-archivo" class="config-select-main">
              <option value="">Cargando...</option>
            </select>
          </div>
        </aside>

        <section class="config-main">

          <!-- ═══ TAB PERFILES (nuevo) ═══ -->
          <div id="tab-perfiles" class="tab-content active">
            <div class="section-header">
              <h3>Perfiles de Implemento</h3>
              <p>Cada perfil es una configuración completa de sembradora. Creá, duplicá o cambiá entre ellos.</p>
            </div>

            <div style="display:flex;gap:8px;margin-bottom:16px;">
              <button class="btn-action-add" onclick="crearNuevoPerfil()" style="flex:0 0 auto">
                <i class="fas fa-plus"></i> NUEVO PERFIL
              </button>
            </div>

            <div id="perfiles-lista" style="display:flex;flex-direction:column;gap:8px;">
              <div style="color:#555;font-size:12px;text-align:center;padding:20px">Cargando perfiles...</div>
            </div>
          </div>

          <!-- ═══ TAB NODOS ═══ -->
            <%- include('config_tab_nodos') %>
          <!-- ═══ TAB GENERAL (limpio) ═══ -->
          <div id="tab-general" class="tab-content" style="display:none">
            <div class="section-header">
              <h3>Estructura de la Sembradora</h3>
              <p>Parámetros base del implemento.</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Nombre del Implemento</label>
                <input type="text" id="cfg-nombre" placeholder="Ej: Tanzi 43" />
              </div>
              <div class="input-card">
                <label>Distancia entre Líneas (m)</label>
                <input type="number" step="0.001" id="cfg-distancia" placeholder="0.191" />
              </div>
              <div class="input-card">
                <label>Tolerancia de Desvío (%)</label>
                <input type="number" step="1" id="cfg-tolerancia-desvio" placeholder="20" />
              </div>
              <div class="input-card">
                <label>RPM Turbina (Mínimo)</label>
                <input type="number" id="cfg-rpm-min" placeholder="2500" />
              </div>
              <div class="input-card">
                <label>RPM Turbina (Máximo)</label>
                <input type="number" id="cfg-rpm-max" placeholder="4500" />
              </div>
              <div class="input-card">
                <label>Cantidad de Tolvas</label>
                <input type="number" id="cfg-qty-tolvas" value="2" />
              </div>
            </div>

            <div class="section-header" style="margin-top:20px">
              <h3>Objetivo de Densidad por Tren</h3>
              <p>Si no se especifica, se usa el objetivo global del header.</p>
            </div>
            <div class="card-grid" id="cfg-objetivos-trenes"></div>
          </div>

          <!-- ═══ TAB SENSORES ═══ -->
          <div id="tab-sensores" class="tab-content" style="display:none">
            <div class="table-header-actions" style="flex-wrap:wrap; gap:15px">
              <div style="flex:1; min-width:250px">
                <label style="color:var(--accent);font-size:10px;font-weight:bold;text-transform:uppercase;display:block;margin-bottom:5px;">
                  Viendo configuración del Nodo:
                </label>
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                  <select id="select-nodo-filter" class="config-select-main" onchange="cambiarNodo()"></select>
                  <button class="btn-cancel" style="padding:8px 15px" onclick="agregarNuevoNodo()">+ NODO</button>
                  <button
                    id="btn-abrir-ota"
                    onclick="abrirModalOTA()"
                    title="Actualización OTA"
                    style="padding:8px 14px;background:transparent;color:#ffea00;border:1px solid #ffea00;border-radius:4px;font-size:11px;font-weight:bold;cursor:pointer;"
                    onmouseover="this.style.background='rgba(255,234,0,0.1)'"
                    onmouseout="this.style.background='transparent'"
                  >⬆ OTA</button>
                </div>
              </div>

              <button class="btn-action-add" onclick="agregarFilaSensor()">
                <i class="fas fa-plus"></i> AGREGAR CABLE
              </button>
            </div>

            <div class="mapeo-container table-scroll">
              <table class="config-table">
                <thead>
                  <tr>
                    <th>CABLE PIN (1-7)</th>
                    <th>BAJADA / SURCO #</th>
                    <th>TREN</th>
                    <th>TIPO DE SENSOR</th>
                    <th style="text-align:center">ACTIVO</th>
                  </tr>
                </thead>
                <tbody id="lista-sensores-tbody"></tbody>
              </table>
            </div>
          </div>

          <!-- ═══ TAB MAPEO ═══ -->
          <div id="tab-mapeo" class="tab-content" style="display:none">
            <div class="section-header">
              <h3>Distribución en Planta</h3>
              <p>Verificación visual de la numeración de los surcos y trenes.</p>
            </div>
            <div id="mapeo-visual-canvas" class="mapeo-visual-canvas"></div>
          </div>

          <!-- ═══ TAB PANTALLA ═══ -->
          <div id="tab-pantalla" class="tab-content" style="display:none">
            <div class="section-header">
              <h3>Preferencias de Interfaz</h3>
              <p>Ajusta lo que quieres ver y escuchar en pantalla.</p>
            </div>
            <div class="card-grid">
              <div class="input-card">
                <label>Sonido de Alerta</label>
                <select id="cfg-audio-file" class="config-select-main" onchange="probarSonido(this.value)">
                  <option value="/sounds/alarma1.mp3">Beep Corto</option>
                  <option value="/sounds/sirena.mp3">Sirena Continua</option>
                  <option value="/sounds/buzzer.mp3">Buzzer Grave</option>
                </select>
              </div>
              <div class="input-card">
                <label>Panel Superior (Velocidad, Dosis)</label>
                <select class="config-select-main" onchange="document.querySelector('.vistax-header').style.display=this.value">
                  <option value="flex">Visible</option>
                  <option value="none">Oculto</option>
                </select>
              </div>
              <div class="input-card">
                <label>Panel Especiales (Turbinas, Ejes)</label>
                <select class="config-select-main" onchange="document.getElementById('tren-especiales').style.display=this.value">
                  <option value="flex">Visible</option>
                  <option value="none">Oculto</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ═══ TAB MONITOREO ═══ -->
          <div id="tab-monitoreo" class="tab-content" style="display:none">
            <div class="section-header">
              <h3>Inicio de Monitoreo</h3>
              <p>Configura cómo y cuándo se activa el monitoreo de siembra.</p>
            </div>

            <div class="card-grid">
              <div class="input-card" style="grid-column: span 2;">
                <label>Método de Inicio</label>
                <select id="cfg-metodo-inicio" class="config-select-main">
                  <option value="sensores">Por Sensores (caída de semilla detectada)</option>
                  <option value="herramienta">Por Sensor de Implemento (herramienta baja)</option>
                  <option value="pintando">Por AOG pintando (bridge)</option>
                  <option value="manual">Manual (botón en pantalla)</option>
                </select>
              </div>
              <div class="input-card">
                <label>Umbral de Sensores Activos</label>
                <div style="display:flex;align-items:center;gap:10px;">
                  <input type="range" id="cfg-umbral-sensores" min="1" max="10" value="3"
                    style="flex:1" oninput="document.getElementById('cfg-umbral-val').textContent=this.value" />
                  <span id="cfg-umbral-val" style="color:var(--accent);font-weight:700;font-size:14px;min-width:20px">3</span>
                </div>
                <small style="color:#444;font-size:10px">Cantidad mínima de sensores con flujo para iniciar.</small>
              </div>
              <div class="input-card">
                <label>Tiempo de Confirmación (ms)</label>
                <input type="number" id="cfg-tiempo-confirmacion" value="500" step="100" min="0" />
                <small style="color:#444;font-size:10px">Espera antes de confirmar el inicio (evita falsos positivos).</small>
              </div>
            </div>

            <div style="margin-top:20px;background:#0a0a0a;border:1px solid #1a1a1a;border-radius:6px;padding:16px;">
              <div style="display:flex;align-items:center;gap:10px;">
                <div id="monitoreo-estado-dot" style="width:10px;height:10px;border-radius:50%;background:#333;flex-shrink:0"></div>
                <div>
                  <div style="font-size:10px;color:#555;text-transform:uppercase;font-weight:700">Estado Actual</div>
                  <div id="monitoreo-estado-txt" style="font-size:13px;color:#888;font-weight:600">Conectando...</div>
                </div>
              </div>
            </div>
          </div>

        </section>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-footer btn-cancel" onclick="cerrarModal()">
        <i class="fas fa-times"></i> DESCARTAR
      </button>
      <button class="btn-footer btn-save" onclick="guardarConfiguracionCompleta()">
        <i class="fas fa-save"></i> GUARDAR Y APLICAR
      </button>
    </div>
  </div>
</div>

<!-- Modal OTA (sin cambios) -->
<%- include('config_ota_modal') %>
