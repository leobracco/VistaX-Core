<footer class="vistax-footer">

  <%# ═══ TOGGLE DE LOTE — Botón dual verde/rojo con timer ═══ %>
  <button class="btn-toggle-lote lote-inactivo" id="btn-toggle-lote" title="Click para INICIAR lote">
    <i class="fas fa-play" id="lote-toggle-icon"></i>
    <span id="lote-toggle-label">SIN LOTE</span>
    <span class="lote-toggle-timer" id="lote-toggle-timer" style="display:none">00:00</span>
  </button>

  <div id="alert-ticker" class="alert-ticker">
    SISTEMA DE MONITOREO VISTAX LISTO
  </div>

  <div class="actions">
    <div class="especiales-container" id="tren-especiales"></div>
    <button class="btn-tool" onclick="abrirModal()" title="Configuración">
      <i class="fas fa-cog"></i>
    </button>
    <button class="btn-tool" onclick="toggleMute()" title="Silenciar alertas">
      <i class="fas fa-volume-up"></i>
    </button>
  </div>
</footer>
