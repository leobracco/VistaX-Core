<footer class="vistax-footer">
  <%# Botón lote — cambia aspecto según estado %>
  <div class="lote-info" id="lote-info-footer" onclick="abrirModalLote()" title="Gestionar lote">
    <i class="fas fa-seedling"></i>
    <span id="txt-lote">
      <% if (loteActivo && loteActivo.activo) { %>
        <%= loteActivo.nombre.toUpperCase() %>
      <% } else { %>
        SIN LOTE — INICIAR
      <% } %>
    </span>
    <i class="fas fa-chevron-up" style="font-size:10px;margin-left:4px;opacity:0.5"></i>
  </div>

  <div id="alert-ticker" class="alert-ticker">
    SISTEMA DE MONITOREO VISTAX LISTO
  </div>

  <div class="actions">
    <button class="btn-tool" onclick="abrirModal()" title="Configuración">
      <i class="fas fa-cog"></i>
    </button>
    <button class="btn-tool" onclick="toggleMute()" title="Silenciar alertas">
      <i class="fas fa-volume-up"></i>
    </button>
  </div>
</footer>
