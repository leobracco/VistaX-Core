<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <title>VistaX</title>
  <link rel="stylesheet" href="/css/bar.css"/>
  <link rel="stylesheet" href="/css/all.min.css"/>
</head>
<body>
  <script>window.APP_CONFIG = <%- JSON.stringify(config || {}) %>;</script>

  <div class="app">
    <!-- Barra título mínima -->
    <div class="titlebar">
      <div class="drag">
        <span class="brand">VistaX</span>
        <span class="st" id="tb-st">· Conectado</span>
      </div>
      <button class="tb-btn" onclick="window.open('/config','config','width=900,height=700')" title="Configuración"><i class="fas fa-cog"></i></button>
      <button class="tb-btn" onclick="toggleMuteBar()" title="Silenciar alarmas"><i class="fas fa-volume-up" id="tb-mute-icon"></i></button>
      <button class="tb-btn tb-close" onclick="window.close()" title="Cerrar">✕</button>
    </div>

    <div class="body">
      <!-- KPIs izquierda -->
      <div class="panel-left">
        <div class="kpi"><span class="lb">VEL</span><span class="vl w" id="pv-vel">0.0</span><span class="un">km/h</span></div>
        <div class="kpi"><span class="lb">OBJ</span><span class="vl g" id="pv-obj"><%- config.setup?.densidad_objetivo || 16 %></span><span class="un">s/m</span></div>
        <div class="kpi"><span class="lb">PROM</span><span class="vl w" id="pv-spm">0.0</span><span class="un">s/m</span></div>
        <div class="kpi"><span class="lb">FALLAS</span><span class="vl r" id="pv-fallas">0</span></div>
      </div>

      <!-- Tubos centro -->
      <div class="center">
        <div class="row" id="tren-top"></div>
        <div class="row" id="tren-bot"></div>
      </div>

      <!-- Especiales derecha -->
      <div class="panel-right">
        <div class="ei" id="ei-rpm" style="display:none"><i class="fas fa-fan"></i><span class="vl" id="ev-rpm">—</span></div>
        <div class="ei" id="ei-eje1" style="display:none"><i class="fas fa-cogs"></i><span class="vl" id="ev-eje1">—</span></div>
        <div class="ei" id="ei-eje2" style="display:none"><i class="fas fa-cogs"></i><span class="vl" id="ev-eje2">—</span></div>
        <div class="ei" id="ei-tolva1" style="display:none"><i class="fas fa-archive"></i><span class="vl" id="ev-tolva1">—</span></div>
        <div class="ei" id="ei-tolva2" style="display:none"><i class="fas fa-archive"></i><span class="vl" id="ev-tolva2">—</span></div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/config_perfiles.js?v=1"></script>
  <script src="/js/bar.js"></script>
</body>
</html>
