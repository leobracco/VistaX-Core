<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>VistaX</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
        width: 100%;
        overflow: hidden;
        background: #000;
        font-family: "Segoe UI", sans-serif;
        color: #fff;
      }
      .app {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
      }

      /* ── Barra título mínima ── */
      .titlebar {
        height: 16px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        background: #050505;
        border-bottom: 1px solid #111;
        padding: 0;
        overflow: hidden;
      }
      .drag {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0 8px;
        height: 100%;
        cursor: move;
        -webkit-app-region: drag;
      }
      .drag .brand {
        font-size: 9px;
        font-weight: 900;
        color: #00e676;
      }
      .drag .st {
        font-size: 7px;
        color: #333;
      }
      .tb-btn {
        background: transparent;
        border: none;
        color: #333;
        font-size: 9px;
        cursor: pointer;
        height: 100%;
        padding: 0 8px;
        display: flex;
        align-items: center;
        -webkit-app-region: no-drag;
      }
      .tb-btn:hover {
        color: #00e676;
        background: #0a0a0a;
      }
      .tb-close:hover {
        color: #fff;
        background: #c62828;
      }

      /* ── Cuerpo: KPIs izq + tubos centro + especiales der ── */
      .body {
        flex: 1;
        display: flex;
        flex-direction: row;
        overflow: hidden;
        min-height: 0;
      }

      /* Panel izquierdo: KPIs */
      .panel-left {
        width: 58px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 4px 5px;
        background: #050505;
        border-right: 1px solid #1a1a1a;
      }
      .kpi {
        text-align: center;
      }
      .kpi .lb {
        font-size: 6px;
        color: #555;
        text-transform: uppercase;
        display: block;
        line-height: 1;
        letter-spacing: 0.3px;
      }
      .kpi .vl {
        font-size: 12px;
        font-weight: 800;
        line-height: 1.3;
      }
      .kpi .un {
        font-size: 6px;
        color: #444;
      }
      .vl.g {
        color: #00e676;
      }
      .vl.w {
        color: #ccc;
      }
      .vl.r {
        color: #ff1744;
      }

      /* Centro: tubos */
      .center {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
      }
      .row {
        flex: 1;
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: stretch;
        justify-content: center;
        gap: 1px;
        padding: 2px 3px;
        overflow-x: auto;
        overflow-y: hidden;
        min-height: 0;
      }
      .row + .row {
        border-top: 1px solid #111;
      }
      .row::-webkit-scrollbar {
        height: 0;
      }

      /* Panel derecho: especiales */
      .panel-right {
        width: 50px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 4px 4px;
        background: #050505;
        border-left: 1px solid #1a1a1a;
      }
      .ei {
        display: flex;
        align-items: center;
        gap: 3px;
      }
      .ei i {
        font-size: 8px;
        color: #333;
        width: 12px;
        text-align: center;
      }
      .ei .lb {
        font-size: 5px;
        color: #444;
        text-transform: uppercase;
      }
      .ei .vl {
        font-size: 9px;
        font-weight: 700;
        color: #555;
      }
      .ei .vl.ok {
        color: #00e676;
      }
      .ei .vl.warn {
        color: #ffb300;
      }

      /* ── Tubos más anchos ── */
      .t {
        display: flex;
        flex-direction: column;
        flex: 0 0 auto;
        width: 16px;
        border: 1px solid #2a2a2a;
        border-radius: 2px;
        background: #0d0d0d;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s;
      }
      .t:hover {
        border-color: #444;
      }
      .t.f {
        border-color: #ff1744 !important;
        animation: blink 0.6s infinite;
      }
      .t.d {
        border-color: #ffb300 !important;
      }
      @keyframes blink {
        50% {
          border-color: #880000;
        }
      }

      .n {
        font-size: 7px;
        text-align: center;
        color: #f1f1f1;
        background: #111;
        border-bottom: 1px solid #1a1a1a;
        line-height: 1.4;
        flex-shrink: 0;
      }
      .b {
        flex: 1;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }
      .fl {
        width: 100%;
        transition:
          height 0.3s,
          background 0.3s;
        border-radius: 0 0 1px 1px;
      }
      .ld {
        position: absolute;
        top: 2px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        padding: 0 2px;
      }
      .l {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: #1a1a1a;
      }
      .lg {
        background: #00e676;
      }
      .lb {
        background: #42a5f5;
      }
    </style>
    <link rel="stylesheet" href="/css/all.min.css" />
  </head>
  <body>
    <script>
      window.APP_CONFIG = <%- JSON.stringify(config || {}) %>;
    </script>

    <div class="app">
      <!-- Barra título mínima -->
      <div class="titlebar">
        <div class="drag">
          <span class="brand">VistaX</span>
          <span class="st" id="tb-st">· Conectado</span>
        </div>
        <button
          class="tb-btn"
          onclick="window.open('/config', 'config', 'width=900,height=700')"
          title="Configuración"
        >
          <i class="fas fa-cog"></i>
        </button>
        <button class="tb-btn tb-close" onclick="window.close()" title="Cerrar">
          ✕
        </button>
      </div>

      <div class="body">
        <!-- KPIs izquierda -->
        <div class="panel-left">
          <div class="kpi">
            <span class="lb">VEL</span><span class="vl w" id="pv-vel">0.0</span
            ><span class="un">km/h</span>
          </div>
          <div class="kpi">
            <span class="lb">OBJ</span
            ><span class="vl g" id="pv-obj"
              ><%- config.setup?.densidad_objetivo || 16 %></span
            ><span class="un">s/m</span>
          </div>
          <div class="kpi">
            <span class="lb">PROM</span><span class="vl w" id="pv-spm">0.0</span
            ><span class="un">s/m</span>
          </div>
          <div class="kpi">
            <span class="lb">FALLAS</span
            ><span class="vl r" id="pv-fallas">0</span>
          </div>
        </div>

        <!-- Tubos centro -->
        <div class="center">
          <div class="row" id="tren-top"></div>
          <div class="row" id="tren-bot"></div>
        </div>

        <!-- Especiales derecha -->
        <div class="panel-right">
          <div class="ei" id="ei-rpm" style="display: none">
            <i class="fas fa-fan"></i><span class="vl" id="ev-rpm">—</span>
          </div>
          <div class="ei" id="ei-eje1" style="display: none">
            <i class="fas fa-cogs"></i><span class="vl" id="ev-eje1">—</span>
          </div>
          <div class="ei" id="ei-eje2" style="display: none">
            <i class="fas fa-cogs"></i><span class="vl" id="ev-eje2">—</span>
          </div>
          <div class="ei" id="ei-tolva1" style="display: none">
            <i class="fas fa-archive"></i
            ><span class="vl" id="ev-tolva1">—</span>
          </div>
          <div class="ei" id="ei-tolva2" style="display: none">
            <i class="fas fa-archive"></i
            ><span class="vl" id="ev-tolva2">—</span>
          </div>
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      (function () {
        const socket = io();
        window.socket = socket;
        const sensores = (APP_CONFIG.mapeo_sensores || []).filter(
          (s) => s.is_active !== false,
        );
        const setup = APP_CONFIG.setup || {};
        const ESP = [
          "turbina",
          "rotacion_eje",
          "tolva_vacia",
          "bajada_herramienta",
          "bateria",
        ];

        socket.on("connect", () => {
          document.getElementById("tb-st").textContent = "· Conectado";
          document.getElementById("tb-st").style.color = "#333";
        });
        socket.on("disconnect", () => {
          document.getElementById("tb-st").textContent = "· Desconectado";
          document.getElementById("tb-st").style.color = "#ff1744";
        });

        // Especiales
        const espMap = {};
        sensores.forEach((s) => {
          if (!ESP.includes(s.tipo)) return;
          let id = null;
          if (s.tipo === "turbina") id = "rpm";
          else if (s.tipo === "rotacion_eje")
            id = s.bajada <= 1 ? "eje1" : "eje2";
          else if (s.tipo === "tolva_vacia")
            id = s.bajada <= 1 ? "tolva1" : "tolva2";
          if (id) {
            document.getElementById("ei-" + id).style.display = "flex";
            espMap[s.tipo + "-" + s.bajada] = document.getElementById(
              "ev-" + id,
            );
          }
        });

        // Agrupar por surco
        const surcos = {};
        sensores.forEach((s) => {
          if (ESP.includes(s.tipo)) return;
          const b = s.bajada;
          if (!surcos[b])
            surcos[b] = { bajada: b, tren: s.tren || 1, fl: false, fc: false };
          if (s.tipo === "ferti_linea") surcos[b].fl = true;
          if (s.tipo === "ferti_costado") surcos[b].fc = true;
          surcos[b].tren = s.tren || surcos[b].tren;
        });

        const lista = Object.values(surcos).sort((a, b) => a.bajada - b.bajada);
        const trenes = [...new Set(lista.map((s) => s.tren))].sort(
          (a, b) => a - b,
        );
        const trenDel = trenes[0] || 1;

        function obj(t) {
          const p = setup.objetivos_tren;
          if (p && p[t] !== undefined) return parseFloat(p[t]);
          return parseFloat(setup.densidad_objetivo) || 16;
        }
        const tol = parseFloat(setup.tolerancia_desvio) || 20;

        const elTop = document.getElementById("tren-top"),
          elBot = document.getElementById("tren-bot");
        const map = {};
        const fallas = new Set();

        lista.forEach((s) => {
          const c = s.tren === trenDel ? elTop : elBot;
          const d = document.createElement("div");
          d.className = "t";
          d.innerHTML = `<div class="n">${s.bajada}</div><div class="b"><div class="ld">${s.fl ? '<div class="l" id="ll-' + s.bajada + '"></div>' : '<div class="l"></div>'}${s.fc ? '<div class="l" id="lc-' + s.bajada + '"></div>' : '<div class="l"></div>'}</div><div class="fl" id="f-${s.bajada}" style="height:5%;background:#111"></div></div>`;
          d.onclick = () =>
            window.open(
              "/detalle-surco?bajada=" +
                s.bajada +
                "&tren=" +
                s.tren +
                "&tipo=semilla",
              "s_" + s.bajada,
              "width=250,height=400",
            );
          c.appendChild(d);
          map[s.bajada] = { el: d, tren: s.tren };
        });

        if (!elBot.children.length) elBot.style.display = "none";
        if (!elTop.children.length) elTop.style.display = "none";

        socket.on("sensor_update", (data) => {
          const b = parseInt(data.bajada);
          const ek = data.tipo + "-" + data.bajada;
          if (espMap[ek]) {
            espMap[ek].textContent = parseFloat(data.valor).toFixed(0);
            espMap[ek].className =
              "vl" + (parseFloat(data.valor) > 0 ? " ok" : " warn");
            return;
          }
          const t = map[b];
          if (!t) return;
          if (data.tipo === "ferti_linea") {
            const e = document.getElementById("ll-" + b);
            if (e)
              e.className = "l" + (parseFloat(data.valor) > 0 ? " lg" : "");
            return;
          }
          if (data.tipo === "ferti_costado") {
            const e = document.getElementById("lc-" + b);
            if (e)
              e.className = "l" + (parseFloat(data.valor) > 0 ? " lb" : "");
            return;
          }
          const spm = parseFloat(data.spm) || 0,
            o = obj(t.tren),
            f = document.getElementById("f-" + b);
          let c = "#111",
            p = 5;
          if (data.alerta) {
            c = "#ff1744";
            p = 15;
            t.el.className = "t f";
            fallas.add(b);
          } else if (spm > 0) {
            const dv = Math.abs((spm - o) / o) * 100;
            p = Math.max(10, Math.min(95, (spm / o) * 75));
            if (o > 0 && dv > tol) {
              c = "#ffb300";
              t.el.className = "t d";
            } else {
              c = "#00e676";
              t.el.className = "t";
            }
            fallas.delete(b);
          } else {
            t.el.className = "t";
            fallas.delete(b);
          }
          if (f) {
            f.style.height = p + "%";
            f.style.background = c;
          }
          document.getElementById("pv-fallas").textContent = fallas.size;
        });

        socket.on("global_update", (s) => {
          if (s.velocidad !== undefined)
            document.getElementById("pv-vel").textContent = parseFloat(
              s.velocidad,
            ).toFixed(1);
          if (s.promedio !== undefined)
            document.getElementById("pv-spm").textContent = parseFloat(
              s.promedio,
            ).toFixed(1);
        });
      })();
    </script>
  </body>
</html>
