<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <title>VistaX — Iniciar Lote</title>
  <link rel="stylesheet" href="/css/all.min.css"/>
  <link rel="stylesheet" href="/css/vistax.css"/>
  <link rel="stylesheet" href="/css/vistax_v2.css"/>
  <style>
    body { background:#111; margin:0; font-family:'Segoe UI',sans-serif; }
    .container { padding:20px; max-width:420px; margin:0 auto; }
    .header-bar {
      background:rgba(255,23,68,0.08); border:1px solid rgba(255,23,68,0.3);
      border-radius:6px; padding:12px 16px; margin-bottom:20px;
      display:flex; align-items:center; gap:10px;
    }
    .pulse {
      width:10px; height:10px; border-radius:50%; background:#ff1744;
      animation: pulse-anim 1s infinite;
    }
    @keyframes pulse-anim {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,23,68,0.5); }
      50% { box-shadow: 0 0 0 6px rgba(255,23,68,0); }
    }
    .header-bar span { color:#ff1744; font-size:12px; font-weight:700; letter-spacing:0.5px; }
    .field { margin-bottom:14px; }
    .field label { display:block; font-size:10px; color:#666; font-weight:700; text-transform:uppercase; margin-bottom:5px; }
    .field .req { color:#ff1744; }
    .field input, .field select {
      width:100%; padding:10px 12px; background:#1a1a1a; border:1px solid #333;
      border-radius:5px; color:#fff; font-size:13px; font-family:inherit;
    }
    .field input:focus, .field select:focus { border-color:var(--accent, #00e676); outline:none; }
    .row-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .actions { display:flex; gap:10px; margin-top:20px; }
    .btn-ghost {
      flex:1; padding:11px; background:transparent; border:1px solid #333;
      color:#aaa; border-radius:5px; cursor:pointer; font-size:12px; font-weight:600;
    }
    .btn-ghost:hover { border-color:#555; color:#fff; }
    .btn-primary {
      flex:2; padding:11px; background:rgba(0,230,118,0.1); border:1px solid #00e676;
      color:#00e676; border-radius:5px; cursor:pointer; font-size:13px; font-weight:700;
    }
    .btn-primary:hover { background:rgba(0,230,118,0.2); }
    .btn-primary:disabled { opacity:0.5; cursor:not-allowed; }
  </style>
</head>
<body>
  <script>
    window.APP_CONFIG = <%- JSON.stringify(config || {}) %>;
  </script>

  <div class="container">
    <div class="header-bar">
      <div class="pulse"></div>
      <span id="header-txt">SIEMBRA DETECTADA — INICIÁ EL LOTE</span>
    </div>

    <div class="field">
      <label>Nombre del Lote <span class="req">*</span></label>
      <input id="inp-nombre" type="text" placeholder="Ej: La Paloma Norte"
             autocomplete="off" spellcheck="false" oninput="this.style.borderColor=''"/>
    </div>
    <div class="field">
      <label>Cultivo <span class="req">*</span></label>
      <select id="inp-cultivo">
        <option value="">— Seleccionar —</option>
        <option value="maiz">Maíz</option>
        <option value="soja">Soja</option>
        <option value="girasol">Girasol</option>
        <option value="sorgo">Sorgo</option>
        <option value="trigo">Trigo</option>
        <option value="cebada">Cebada</option>
        <option value="otro">Otro</option>
      </select>
    </div>
    <div class="row-2">
      <div class="field">
        <label>Variedad</label>
        <input id="inp-variedad" type="text" placeholder="DK7210" autocomplete="off"/>
      </div>
      <div class="field">
        <label>Establecimiento</label>
        <input id="inp-estab" type="text" placeholder="Los Aromos" autocomplete="off"/>
      </div>
    </div>

    <div class="actions">
      <button class="btn-ghost" onclick="posponer()">
        <i class="fas fa-clock"></i> Posponer
      </button>
      <button class="btn-primary" id="btn-iniciar" onclick="confirmar()">
        <i class="fas fa-play"></i> Iniciar Lote
      </button>
    </div>
  </div>

  <script>
    // Leer origen del trigger desde la URL
    const params = new URLSearchParams(window.location.search);
    const origen = params.get('origen') || 'semilla';
    const msgs = {
      bridge:     'BRIDGE DETECTA SIEMBRA — INICIÁ EL LOTE',
      semilla:    'SEMILLA DETECTADA — INICIÁ EL LOTE',
      implemento: 'HERRAMIENTA BAJA — INICIÁ EL LOTE',
    };
    document.getElementById('header-txt').textContent = msgs[origen] || msgs.semilla;

    // Focus al nombre
    setTimeout(() => document.getElementById('inp-nombre')?.focus(), 200);

    async function confirmar() {
      const nombre   = document.getElementById('inp-nombre')?.value.trim();
      const cultivo  = document.getElementById('inp-cultivo')?.value;
      const variedad = document.getElementById('inp-variedad')?.value.trim();
      const estab    = document.getElementById('inp-estab')?.value.trim();
      const ancho    = APP_CONFIG?.setup?.distancia_entre_surcos || 0.191;

      if (!nombre) {
        const inp = document.getElementById('inp-nombre');
        if (inp) { inp.style.borderColor = '#ff1744'; inp.focus(); }
        return;
      }
      if (!cultivo) {
        const sel = document.getElementById('inp-cultivo');
        if (sel) { sel.style.borderColor = '#ff1744'; sel.focus(); }
        return;
      }

      const btn = document.getElementById('btn-iniciar');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Iniciando...';

      try {
        const res = await fetch('/api/mapa/iniciar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, cultivo, variedad, estab, anchoPasada: ancho }),
        });

        if (res.ok) {
          btn.innerHTML = '<i class="fas fa-check"></i> Lote Iniciado';
          btn.style.background = 'rgba(0,230,118,0.2)';
          // Cerrar ventana después de 800ms
          setTimeout(() => window.close(), 800);
        } else {
          const err = await res.json().catch(() => ({}));
          alert('Error: ' + (err.error || 'Error desconocido'));
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-play"></i> Iniciar Lote';
        }
      } catch (e) {
        alert('Error de conexión');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-play"></i> Iniciar Lote';
      }
    }

    function posponer() {
      // No hay forma directa de comunicar al trigger_manager de la ventana padre,
      // pero al cerrar sin iniciar, el trigger se reactivará en 3 min de todas formas
      window.close();
    }

    // Enter para confirmar
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') confirmar();
      if (e.key === 'Escape') posponer();
    });
  </script>
</body>
</html>
