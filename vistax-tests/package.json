{
  "name": "vistax-tests",
  "version": "1.0.0",
  "description": "Suite de tests para VistaX — Monitor de Siembra Agro Parallel",
  "scripts": {
    "test": "jest --testPathPattern=\"test/(unit|integration|e2e)\" --runInBand --forceExit --verbose",
    "test:unit": "jest test/unit --runInBand --verbose",
    "test:integration": "jest test/integration --runInBand --forceExit --verbose",
    "test:e2e": "jest test/e2e --runInBand --forceExit --verbose",
    "test:live": "jest test/live --runInBand --forceExit --verbose --testTimeout=25000",
    "test:watch": "jest --watch --verbose",
    "test:coverage": "jest --coverage --runInBand --forceExit --verbose"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "socket.io-client": "^4.7.5",
    "mqtt": "^5.3.6",
    "express": "^4.18.2",
    "socket.io": "^4.7.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "verbose": true,
    "forceExit": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "../../core/**/*.js",
      "../../routes/**/*.js",
      "!**/node_modules/**"
    ]
  }
}
